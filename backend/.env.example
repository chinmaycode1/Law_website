PORT=3000 # HTTP server port
MONGO_URI=mongodb://localhost:27017/law_website # MongoDB connection string
EMAIL_USER=your_email@example.com # SMTP email account
EMAIL_PASS=replace_with_email_app_password # SMTP app password
RECIPIENT_EMAIL=recipient@example.com # Address for contact notifications
FRONTEND_URL=http://localhost:8000,http://localhost:3000 # Allowed frontend origins
ADMIN_KEY=replace_with_a_long_random_admin_key # Admin dashboard key
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com # Google Identity Services client ID
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret # Google OAuth client secret; not used by the GIS credential flow
SESSION_JWT_SECRET=replace_with_a_long_random_session_secret # JWT signing secret
RAZORPAY_KEY_ID=rzp_test_replace_with_key_id # Razorpay public key ID
RAZORPAY_KEY_SECRET=replace_with_razorpay_key_secret # Razorpay server-side secret; never expose to the client
RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret # Optional webhook signing secret from the Razorpay dashboard
